# ============================================================
# Verifica Peru - Bot de WhatsApp
# Copia este archivo a ".env" y completa los valores reales.
# NUNCA subas tu archivo ".env" real a GitHub.
# ============================================================

# --- Servidor ---
PORT=3000

# --- WhatsApp Cloud API (Meta for Developers) ---
# Los consigues tu mismo en developers.facebook.com, en tu app de WhatsApp Business.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Token que tu mismo inventas y pones tambien al configurar el webhook en Meta.
WHATSAPP_VERIFY_TOKEN=verifica-peru-webhook
# Opcional pero recomendado: App Secret de tu app de Meta, para validar que los
# webhooks realmente vienen de WhatsApp (evita mensajes falsificados).
WHATSAPP_APP_SECRET=

# --- Numeros de administrador (tu numero personal, NO el del negocio) ---
# Separados por coma, en formato E.164 sin el "+", ej: 51987654321
# Desde estos numeros puedes enviar comandos como "CONFIRMAR VP-AB12CD"
ADMIN_WHATSAPP_NUMBERS=

# Si es "true", el bot espera a que TU confirmes cada pago con el comando
# "CONFIRMAR <codigo>" antes de entregar el resultado. Si es "false", el bot
# confia en la palabra del cliente y continua apenas dice "ya pague".
REQUIRE_MANUAL_PAYMENT_CONFIRMATION=true

# --- Datos de pago que el bot muestra al cliente ---
PAYMENT_PRICE_SOLES=20
PAYMENT_YAPE_NUMBER=
PAYMENT_PLIN_NUMBER=
PAYMENT_BANK_NAME=
PAYMENT_BANK_ACCOUNT=
PAYMENT_BANK_CCI=
PAYMENT_ACCOUNT_HOLDER=Verifica Peru

# --- Base de datos ---
DB_PATH=./data/verifica_peru.db

# --- Anthropic (Claude) API, opcional pero recomendado ---
# Se usa para (1) leer y analizar fotos de contratos de alquiler, y
# (2) redactar el resumen final en espanol de cada verificacion.
# Si lo dejas vacio, el bot usa plantillas de texto mas simples.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Proveedor de datos vehiculares (para el servicio de autos usados) ---
# Cualquier proveedor peruano de consulta vehicular por placa (ej. APIs Peru,
# Factiliza, etc.) que entregue datos de SUNARP/SOAT. Configuras la URL base
# y tu token de ese proveedor.
VEHICULO_API_URL=
VEHICULO_API_KEY=

# --- Proveedor de consulta RUC / SUNAT (para riesgo tributario) ---
RUC_API_URL=
RUC_API_KEY=

# --- Proveedor de papeletas / multas de transito ---
PAPELETAS_API_URL=
PAPELETAS_API_KEY=
